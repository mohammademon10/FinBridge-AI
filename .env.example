# FinBridge AI — Environment Configuration Example
# Copy this file to backend/.env or configure your environment accordingly.
# Note: No secrets are required to run the deterministic demo mode.

# Backend Configuration
APP_ENV=development
API_PORT=8000
DATABASE_URL=sqlite:///./finbridge.db

# Optional AI Assistant (Defaults to high-fidelity deterministic demo mode if omitted)
# Supports OpenAI, Anthropic, or Gemini format if configured
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_PROVIDER=mock

# Optional Live Exchange Rate API (ExchangeRate-API or Open Exchange Rates)
CURRENCY_API_KEY=

# Frontend Configuration (place in frontend/.env if customizing)
VITE_API_BASE_URL=http://localhost:8000
